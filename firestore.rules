rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function classDoc(code) {
      return get(/databases/$(database)/documents/classes/$(code)).data;
    }

    function rosterPath(code) {
      return /databases/$(database)/documents/classes/$(code)/meta/roster;
    }

    match /classes/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.matches('[A-Z]{4}')
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.level in ['easy', 'medium', 'hard']
        && request.resource.data.rounds is int
        && request.resource.data.rounds >= 1
        && request.resource.data.rounds <= 20;

      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid;

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      // Head count for the class-size cap (30). Rules cannot count documents, so this document does.
      // It is separate from the class document so students, who listen to that one, are not re-read
      // every time someone joins. Classes made before this existed have no roster and are uncapped.
      match /meta/roster {
        allow get: if signedIn();

        // The teacher creates it with the class, starting at zero.
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['count', 'expiresAt'])
          && request.resource.data.count == 0
          && request.resource.data.expiresAt is timestamp
          && getAfter(/databases/$(database)/documents/classes/$(code)).data.hostUid == request.auth.uid;

        // A joining student adds exactly one, while under 30, in the same batch that creates their own
        // player document.
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= 30
          && !exists(/databases/$(database)/documents/classes/$(code)/players/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/classes/$(code)/players/$(request.auth.uid));

        // The teacher frees a seat when removing a student.
        allow update: if signedIn()
          && classDoc(code).hostUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
          && request.resource.data.count == resource.data.count - 1
          && request.resource.data.count >= 0;

        allow delete: if signedIn() && classDoc(code).hostUid == request.auth.uid;
      }

      match /players/{uid} {
        allow get: if signedIn()
          && (request.auth.uid == uid || classDoc(code).hostUid == request.auth.uid);
        allow list, delete: if signedIn() && classDoc(code).hostUid == request.auth.uid;

        allow create: if signedIn()
          && request.auth.uid == uid
          && classDoc(code).phase != 'done'
          && (!exists(rosterPath(code))
              || (get(rosterPath(code)).data.count < 30
                  && getAfter(rosterPath(code)).data.count == get(rosterPath(code)).data.count + 1))
          && request.resource.data.keys().hasOnly(['name', 'joinedAt', 'lines', 'expiresAt'])
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 16
          && request.resource.data.lines == {};

        // A student may add exactly one line, for the current round, while guessing is open.
        allow update: if signedIn()
          && request.auth.uid == uid
          && classDoc(code).phase == 'guess'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lines'])
          && request.resource.data.lines.diff(resource.data.lines).addedKeys()
               .hasOnly(['r' + string(classDoc(code).round)])
          && request.resource.data.lines.diff(resource.data.lines).changedKeys().size() == 0
          && request.resource.data.lines['r' + string(classDoc(code).round)] is list
          && request.resource.data.lines['r' + string(classDoc(code).round)].size() == 4;
      }
    }
  }
}
